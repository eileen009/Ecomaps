# ===== EcoMaps - variables de entorno (SIN valores reales) =====
# Copia este archivo a app/.env y completa tus datos. Nunca subas .env a GitHub.
# En Render se configuran en Environment, no se escriben en el código.

# ----- Base de datos MySQL (en local: XAMPP; en la nube: Aiven) -----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=ecomapsbd
# Certificado SSL (solo Aiven). Local: dejar vacío.
# Render: sube ca.pem como Secret File y usa MYSQL_SSL_CA=/etc/secrets/ca.pem
MYSQL_SSL_CA=

# ----- Seguridad -----
# Cadena aleatoria de 32+ caracteres (ej: python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# ----- Sitio -----
# URL pública sin "/" final (en local: http://localhost:5000)
APP_URL=http://localhost:5000
FLASK_ENV=development
FLASK_DEBUG=1

# ----- Servicios opcionales (si se dejan vacíos, la función se desactiva) -----
# Inicio de sesión con Google (ID de cliente OAuth "Aplicación web")
GOOGLE_CLIENT_ID=
# Recuperar contraseña por correo (Brevo)
BREVO_API_KEY=
CORREO_REMITENTE=
# Correo del equipo que recibe el aviso cuando alguien marca "soy una empresa"
CORREO_EQUIPO=ecoomaps@gmail.com
# Fotos en la nube (Cloudinary). Local vacío = se guardan en static/uploads
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
